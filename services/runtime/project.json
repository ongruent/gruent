{
  "name": "runtime",
  "root": "services/runtime",
  "sourceRoot": "services/runtime",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "./gradlew :services:runtime:installDist"
      },
      "outputs": [
        "{projectRoot}/build/install"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "./gradlew :services:runtime:test :libs:engine:steps:plugins:timer-source:v1:test :libs:engine:steps:plugins:log:v1:test"
      },
      "outputs": [
        "{projectRoot}/build/test-results"
      ]
    },
    "image": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "services/runtime/deploy/local/ctl.sh image"
      }
    }
  },
  "tags": [
    "kotlin",
    "runtime"
  ],
  "implicitDependencies": [
    "steps"
  ]
}
