ENVIRONMENT=development

# Vault
VAULT_ADDRESS="http://127.0.0.1:8200"
API_VAULT_USERNAME="http-api"
API_VAULT_PASSWORD="gruent"

# The values below are read from Vault (config/controller), which deploy/platform/local/seed-vault.sh seeds
# from deploy/platform/local/.env.controller. They are listed here with host addresses for running the
# controller outside Docker.
LOG_LEVEL="debug"

# Controller gRPC server port
CONTROLLER_SERVER_PORT=9002

# Database
DATABASE_URL=postgresql://gruent:gruent@127.0.0.1:5432/gruent

# Observability
OTEL_COLLECTOR_ENDPOINT="127.0.0.1:4317"

# Artifact storage (the local MinIO container). The bucket is created on startup.
ARTIFACT_STORAGE_ENDPOINT=127.0.0.1:8675
ARTIFACT_STORAGE_ACCESS_KEY_ID=gruent
ARTIFACT_STORAGE_SECRET_ACCESS_KEY=gruentstorage!
ARTIFACT_STORAGE_BUCKET=channel-artifacts
ARTIFACT_STORAGE_REGION=us-east-1
ARTIFACT_STORAGE_USE_SSL=false

# Artifact signing. LOCAL DEVELOPMENT ONLY: this key is public. Each environment uses its own Ed25519
# seed (base64, 32 bytes), e.g. `openssl rand -base64 32`, and publishes the matching public key (logged
# on startup) to artifact consumers under the key ID.
ARTIFACT_SIGNING_KEY_ID=local-dev-1
ARTIFACT_SIGNING_PRIVATE_KEY=gn4yyRDEl9VZSnQMZDkd8Uz3KjkDDKZ3v181dnFB7ok=

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=gruent
REDIS_PASSWORD=gruent

# Optional integration test variables, set in the shell when running `pnpm nx test controller`. The Postgres
# test is skipped unless the database URL is set, and uses in-memory artifact storage unless the S3 endpoint is set.
# CONTROLLER_TEST_DATABASE_URL=postgresql://gruent:gruent@127.0.0.1:5432/gruent
# CONTROLLER_TEST_S3_ENDPOINT=127.0.0.1:8675
# CONTROLLER_TEST_S3_ACCESS_KEY_ID=gruent
# CONTROLLER_TEST_S3_SECRET_ACCESS_KEY=gruentstorage!
