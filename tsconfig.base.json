{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "esModuleInterop": true,
    "noEmit": true,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2017", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@gruent/hub/*": ["apps/hub/src/*"],
      "@gruent/libs/engine/channels/*": ["libs/engine/channels/*"],
      "@gruent/libs/engine/dependencies/*": ["libs/engine/dependencies/*"],
      "@gruent/libs/engine/nodes/*": ["libs/engine/nodes/*"],
      "@gruent/libs/frontend/*": ["libs/frontend/src/*"],
      "@gruent/libs/http/*": ["libs/http/*"],
      "@gruent/libs/gruent-js/*": ["libs/gruent-js/*"],
      "@gruent/site/*": ["apps/site/src/*"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
