# All the env vars here are tightly coupled with the name of the containers
# in the docker compose file in this folder.

LOG_LEVEL="debug"

# Controller grpc server port
CONTROLLER_SERVER_PORT=9002

# Database
DATABASE_URL=postgresql://gruent:gruent@postgres:5432/gruent

# Observability
OTEL_COLLECTOR_ENDPOINT="otel-collector:4317"

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=gruent
REDIS_PASSWORD=gruent
