# All the env vars here are tightly coupled with the name of the containers
# in the docker compose file in this folder.

LOG_LEVEL="debug"

# Controller grpc server port
CONTROLLER_SERVER_PORT=9002

# Database
DATABASE_URL=postgresql://gruent:gruent@postgres:5432/gruent

# Observability
OTEL_COLLECTOR_ENDPOINT="otel-collector:4317"

# Artifact storage (the local MinIO container). The bucket is created on startup.
ARTIFACT_STORAGE_ENDPOINT=minio:8675
ARTIFACT_STORAGE_ACCESS_KEY_ID=gruent
ARTIFACT_STORAGE_SECRET_ACCESS_KEY=gruentstorage!
ARTIFACT_STORAGE_BUCKET=channel-artifacts
ARTIFACT_STORAGE_REGION=us-east-1
ARTIFACT_STORAGE_USE_SSL=false

# Artifact signing. LOCAL DEVELOPMENT ONLY: this key is public. Each environment uses its own Ed25519
# seed (base64, 32 bytes), e.g. `openssl rand -base64 32`, and publishes the matching public key (logged
# on startup) to artifact consumers under the key ID.
ARTIFACT_SIGNING_KEY_ID=local-dev-1
ARTIFACT_SIGNING_PRIVATE_KEY=gn4yyRDEl9VZSnQMZDkd8Uz3KjkDDKZ3v181dnFB7ok=

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=gruent
REDIS_PASSWORD=gruent

# NATS, for runtime observations
NATS_URL=nats://nats:4222

# Runtime workers in the local kind cluster (services/runtime/deploy/local). The controller deploys them with
# KUBECONFIG, which docker-compose.yaml sets. Addresses are as seen from the cluster's pods.
RUNTIME_NAMESPACE=gruent-runtime
RUNTIME_IMAGE=gruent-runtime:local
RUNTIME_IMAGE_PULL_POLICY=Never
RUNTIME_NATS_URL=nats://nats:4222
RUNTIME_OTEL_COLLECTOR_ENDPOINT=http://otel-collector:4317
RUNTIME_ARTIFACT_STORAGE_ENDPOINT=minio:8675
# Vault, from which workers resolve the secrets of their channel's connections (e.g. a Postgres password).
# The runtime user only reads the spaces' secrets (deploy/platform/local/build/vault/config/entrypoint.sh).
RUNTIME_VAULT_ADDRESS=http://vault:8200
RUNTIME_VAULT_USERNAME=runtime
RUNTIME_VAULT_PASSWORD=gruent
