# All the env vars here are tightly coupled with the name of the containers
# in the docker compose file in this folder.

LOG_LEVEL="debug"

# Controller grpc server port
CONTROLLER_SERVER_PORT=9002

# Database
DATABASE_URL=postgresql://gruent:gruent@postgres:5432/gruent

# Observability
OTEL_COLLECTOR_ENDPOINT="otel-collector:4317"

# Artifact storage (the local MinIO container). The bucket is created on startup.
ARTIFACT_STORAGE_ENDPOINT=minio:8675
ARTIFACT_STORAGE_ACCESS_KEY_ID=gruent
ARTIFACT_STORAGE_SECRET_ACCESS_KEY=gruentstorage!
ARTIFACT_STORAGE_BUCKET=channel-artifacts
ARTIFACT_STORAGE_REGION=us-east-1
ARTIFACT_STORAGE_USE_SSL=false

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=gruent
REDIS_PASSWORD=gruent
