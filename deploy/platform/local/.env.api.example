# All the env vars here are tightly coupled with the name of the containers
# in the docker compose file in this folder.

LOG_LEVEL="debug"

# API server port
API_SERVER_PORT=9001

# Controller grpc server endpoint
CONTROLLER_GRPC_SERVER_URL="controller:9002"

# Collector runtime metrics end point
COLLECTOR_GRPC_RUNTIME_URL="collector:50053"

# Database
DATABASE_URL=postgresql://gruent:gruent@postgres:5432/gruent
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# Clickhouse
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=9000
CLICKHOUSE_USERNAME=gruent
CLICKHOUSE_PASSWORD=gruent
CLICKHOUSE_DATABASE=default

# Observability
OTEL_COLLECTOR_ENDPOINT="otel-collector:4317"

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=gruent
REDIS_PASSWORD=gruent

# SMTP
SMTP_HOST=inbucket
SMTP_PORT=2500
SMTP_USER=gruent
SMTP_PASSWORD=gruent

# HTTP trigger ingress: /v1/trigger/http/<channel ID> invokes channels published to the runtime platform
# over NATS, using the routing table the controller writes to artifact storage. Channels without a
# published route keep using the legacy trigger. Unset NATS_URL to disable the ingress.
NATS_URL=nats://nats:4222
ARTIFACT_STORAGE_ENDPOINT=minio:8675
ARTIFACT_STORAGE_ACCESS_KEY_ID=gruent
ARTIFACT_STORAGE_SECRET_ACCESS_KEY=gruentstorage!
ARTIFACT_STORAGE_BUCKET=channel-artifacts
ARTIFACT_STORAGE_REGION=us-east-1
ARTIFACT_STORAGE_USE_SSL=false
# Public key of the controller's local signing key (ARTIFACT_SIGNING_KEY_ID/_PRIVATE_KEY in .env.controller)
ARTIFACT_SIGNING_KEYRING=local-dev-1=Pq48nVKCNmPjOGPdi1fNgC0OshAyH8qdTfpqO/Qj8eE=
