{
	"name": "frontend",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "deploy/frontend",
	"projectType": "application",
	"targets": {
		"start": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "{workspaceRoot}",
				"command": "deploy/frontend/local/ctl.sh up"
			}
		},
		"stop": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "{workspaceRoot}",
				"command": "deploy/frontend/local/ctl.sh down"
			}
		}
	},
	"tags": []
}
