{
  "plugins": [
    "@typescript-eslint"
  ],
  "extends": [
    "../../.eslintrc.json",
    "next",
    "next/core-web-vitals"
  ],
  "overrides": [
    {
      "files": ["*.ts", "*.tsx", "*.js", "*.jsx"],
      "rules": {
        "@typescript-eslint/no-unused-vars": [
          "error",
          {
            "argsIgnorePattern": "^_",
            "varsIgnorePattern": "^_"
          }
        ],
        "@next/next/no-html-link-for-pages": [
          "error",
          "apps/app-gruent-com/src"
        ]
      }
    },
    {
      "files": ["*.ts", "*.tsx"],
      "rules": {}
    },
    {
      "files": ["*.js", "*.jsx"],
      "rules": {}
    }
  ]
}