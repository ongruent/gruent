{
  "description": "An input field, a fixed value, text with input values and array items.",
  "config": {
    "outputModelId": "mdl_out",
    "mappings": [
      { "target": "deviceId", "source": "device.id" },
      { "target": "unit", "source": "$value", "value": "celsius" },
      { "target": "label", "source": "$template", "value": "Device {{device.name}}" },
      { "target": "values[].c", "source": "readings[].celsius" }
    ]
  }
}
