{
  "name": "gruent-js",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/gruent-js/src",
  "projectType": "library",
  "tags": [
    "react"
  ],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "lintFilePatterns": [
          "libs/gruent-js/src/**/*.{ts,tsx}"
        ]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "libs/gruent-js/jest.config.ts",
        "collectCoverage": true,
        "coverageDirectory": "{workspaceRoot}/coverage/libs/gruent-js",
        "coverageReporters": ["text", "cobertura"],
        "passWithNoTests": false
      }
    }
  }
}
